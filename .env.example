# Branch Merger: copy to .env (next to main.py) and fill in. .env is git-ignored.
# Variables already set in your shell take precedence over this file.
#
# Jira, used by the Jira panel. Optional: you can fill these in on the page instead
# (Settings > Jira); the page's settings win when all three are filled in there.

# Jira Cloud site, https only
JIRA_URL=https://monolithss.atlassian.net
# The email of your Atlassian account
JIRA_EMAIL=you@onedatasource.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# The port and the repository are command-line options, not variables:
#   python3 main.py --repo /path/to/your/clone [--port 8765]
